// IMS Prisma Schema
// Covers: Auth/RBAC, Notifications, Dashboard, Inventory, Warehouse, Production,
// BOM, MRP, Lab, Sales, Purchasing, Finance, HR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// AUTH / RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRATOR
  PRODUCTION_MANAGER
  WAREHOUSE_MANAGER
  PURCHASING_OFFICER
  SALES_STAFF
  FINANCE
  HR
  QA
  EMPLOYEE
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(EMPLOYEE)
  isActive       Boolean   @default(true)
  avatarUrl      String?
  resetToken     String?   @unique
  resetTokenExp  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  workOrders     WorkOrder[]      @relation("WorkOrderCreatedBy")
  salesOrders    SalesOrder[]     @relation("SalesOrderCreatedBy")
  purchaseOrders PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  auditLogs      AuditLog[]
  notificationReads NotificationRead[]
  supplierInvoices SupplierInvoice[] @relation("SupplierInvoiceCreatedBy")
  customerInvoices CustomerInvoice[] @relation("CustomerInvoiceCreatedBy")
  employeeProfile   Employee?

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

/// One alert, addressed to whoever should see it rather than to one person.
/// A shared alert with a per-user read flag needs two tables: the alert row is
/// written once by whatever raised it, and each user who dismisses it gets their
/// own row in NotificationRead. A single readAt on Notification would dismiss
/// the alert for everybody, including the people who never opened it.
model Notification {
  id       String               @id @default(cuid())
  /// Event family, e.g. "REORDER_BREACH" or "REORDER_RECOVERED".
  type     String
  severity NotificationSeverity @default(INFO)
  title    String
  body     String?
  /// Where the bell deep-links, e.g. "/mrp".
  href     String?
  /// Stable identity of the event, so a repeat is one row rather than a queue
  /// of identical pings. Null for alerts that should always raise on their own.
  dedupeKey String?
  createdAt DateTime            @default(now())

  reads NotificationRead[]

  /// Postgres treats NULLs as distinct, so unkeyed alerts are never collapsed
  /// while every keyed alert can only be raised once.
  @@unique([dedupeKey])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// ---------------------------------------------------------------------------
// INVENTORY / WAREHOUSE
// ---------------------------------------------------------------------------

enum ItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_GOOD
  CONSUMABLE
}

model Item {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  type          ItemType @default(RAW_MATERIAL)
  unit          String   @default("pcs")
  costPrice     Decimal  @default(0) @db.Decimal(14, 2)
  salePrice     Decimal  @default(0) @db.Decimal(14, 2)
  reorderPoint  Int      @default(0)
  reorderQty    Int      @default(0)
  isActive      Boolean  @default(true)
  /// Where replenishment for this item is normally bought. MRP groups its
  /// suggestions by this so one run produces one draft PO per supplier.
  preferredSupplierId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  bomComponents   BomComponent[]
  finishedBoms    Bom[]             @relation("BomFinishedItem")
  workOrders      WorkOrder[]
  salesOrderLines SalesOrderLine[]
  poLines         PurchaseOrderLine[]
  mrpLines        MrpLine[]
  preferredSupplier Supplier?     @relation("ItemPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  supplierInvoiceLines SupplierInvoiceLine[]
  customerInvoiceLines CustomerInvoiceLine[]

  @@index([type])
  @@map("items")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  workOrders     WorkOrder[]

  @@map("warehouses")
}

model StockLevel {
  id          String    @id @default(cuid())
  itemId      String
  warehouseId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@map("stock_levels")
}

/// Every quantity change to a StockLevel, as an immutable signed delta.
/// StockLevel.quantity is a projection of the sum of these rows, so the
/// ledger and the on-hand number can never disagree.
enum StockMovementReason {
  /// Baseline recorded when the ledger was introduced. Never written by the app.
  OPENING_BALANCE
  /// Goods received against a purchase order.
  PURCHASE_RECEIPT
  /// Finished units credited by completing a work order.
  PRODUCTION_OUTPUT
  /// BOM components consumed by completing a work order.
  PRODUCTION_CONSUMPTION
  /// Finished units written off as scrap at work-order completion.
  SCRAP_WRITEOFF
  /// Units issued to a customer on sales-order fulfilment.
  SALES_ISSUE
  /// Manual correction, e.g. a miscount found during a cycle count.
  ADJUSTMENT
}

model StockMovement {
  id          String              @id @default(cuid())
  itemId      String
  warehouseId String
  /// Signed: positive adds stock, negative removes it.
  qtyDelta    Int
  reason      StockMovementReason
  /// Originating aggregate, e.g. "WORK_ORDER" or "SALES_ORDER".
  refType     String
  refId       String
  note        String?
  occurredAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([itemId, occurredAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// PRODUCTION / BOM / MRP
// ---------------------------------------------------------------------------

model Bom {
  id             String   @id @default(cuid())
  name           String
  finishedItemId String
  version        String   @default("1.0")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  finishedItem Item           @relation("BomFinishedItem", fields: [finishedItemId], references: [id])
  components   BomComponent[]
  workOrders   WorkOrder[]

  @@index([finishedItemId])
  @@map("boms")
}

model BomComponent {
  id       String  @id @default(cuid())
  bomId    String
  itemId   String
  quantity Decimal @db.Decimal(14, 3)

  bom  Bom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@map("bom_components")
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id           String          @id @default(cuid())
  orderNumber  String          @unique
  bomId        String
  itemId       String
  warehouseId  String
  quantity     Int
  status       WorkOrderStatus @default(PLANNED)
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  bom       Bom       @relation(fields: [bomId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  @@map("work_orders")
}

model MrpRun {
  id        String     @id @default(cuid())
  name      String
  runAt     DateTime   @default(now())
  notes     String?
  lines     MrpLine[]
  purchaseOrders PurchaseOrder[]

  @@map("mrp_runs")
}

model MrpLine {
  id            String  @id @default(cuid())
  mrpRunId      String
  itemId        String
  onHandQty     Int
  demandQty     Int
  suggestedQty  Int
  /// Denormalised from Item.preferredSupplierId at run time, so a later change
  /// to the item master cannot rewrite which supplier a past run proposed.
  supplierId    String?
  /// Set once this suggestion has been turned into a purchase order, which is
  /// what stops the same run being generated into duplicate POs.
  purchaseOrderId String?

  mrpRun        MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  item          Item   @relation(fields: [itemId], references: [id])
  supplier      Supplier? @relation("MrpLineSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation("MrpLinePurchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@map("mrp_lines")
}

// ---------------------------------------------------------------------------
// QUALITY LABORATORY
// ---------------------------------------------------------------------------

model LabTestRecord {
  id        String   @id @default(cuid())
  category  String
  material  String
  testName  String
  result    Float
  unit      String
  standard  String?
  minValue  Float?
  maxValue  Float?
  status    String
  details   Json?
  testedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([category, material])
  @@index([status])
  @@map("lab_test_records")
}

model LabMixDesign {
  id               String   @id @default(cuid())
  name             String
  productType      String
  requiredStrength Float
  cementType       String
  recipe           Json
  corrections      Json
  metrics          Json
  standard         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productType])
  @@map("lab_mix_designs")
}

// ---------------------------------------------------------------------------
// SALES
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders    SalesOrder[]
  customerInvoices CustomerInvoice[]

  @@map("customers")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  customerId  String
  status      SalesOrderStatus @default(DRAFT)
  orderDate   DateTime         @default(now())
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  createdBy User              @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  lines     SalesOrderLine[]
  customerInvoices CustomerInvoice[]

  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(cuid())
  salesOrderId String
  itemId       String
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  /// Cost frozen at fulfilment. Null before that, and for orders that never
  /// fulfil, in which case reporting falls back to the item's current cost.
  unitCost     Decimal? @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])

  @@map("sales_order_lines")
}

// ---------------------------------------------------------------------------
// PURCHASING
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  preferredByItems Item[]        @relation("ItemPreferredSupplier")
  mrpLines      MrpLine[]       @relation("MrpLineSupplier")
  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now())
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  lines     PurchaseOrderLine[]
  mrpRunId  String?
  mrpRun      MrpRun?          @relation(fields: [mrpRunId], references: [id], onDelete: SetNull)
  mrpLines    MrpLine[]        @relation("MrpLinePurchaseOrder")
  supplierInvoices SupplierInvoice[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitCost        Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// FINANCE
// ---------------------------------------------------------------------------

/// Payment status shared by both invoice directions. ISSUE and payment tracking
/// are separate concerns: an issued invoice with no money against it is OVERDUE
/// once its due date passes, and a cancelled invoice never becomes PAID.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/// Which side of the ledger an invoice sits on. Money owed to us is an inflow;
/// money we owe is an outflow, and the two are never the same document.
enum PaymentParty {
  SUPPLIER
  CUSTOMER
}

model SupplierInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  supplierId      String
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  /// Running total of Payment.amount. Stored rather than summed on read so the
  /// outstanding balance is answerable by an index instead of a join.
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  /// Source document, when the invoice bills a purchase order.
  purchaseOrderId String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User                 @relation("SupplierInvoiceCreatedBy", fields: [createdById], references: [id])
  lines         SupplierInvoiceLine[]
  payments      Payment[]

  @@index([status])
  @@index([dueDate])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id                String   @id @default(cuid())
  supplierInvoiceId String
  /// Null for a fee that is not stock, e.g. freight or a tooling charge.
  itemId            String?
  description       String
  quantity          Int
  unitCost          Decimal  @db.Decimal(14, 2)
  lineTotal         Decimal  @db.Decimal(14, 2)

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  item            Item?           @relation(fields: [itemId], references: [id])

  @@map("supplier_invoice_lines")
}

model CustomerInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerId      String
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  /// Source document, when the invoice bills a sales order.
  salesOrderId    String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    Customer             @relation(fields: [customerId], references: [id])
  salesOrder  SalesOrder?          @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("CustomerInvoiceCreatedBy", fields: [createdById], references: [id])
  lines       CustomerInvoiceLine[]
  payments    Payment[]

  @@index([status])
  @@index([dueDate])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id               String   @id @default(cuid())
  customerInvoiceId String
  itemId           String?
  description      String
  quantity         Int
  unitPrice        Decimal  @db.Decimal(14, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)

  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  item            Item?           @relation(fields: [itemId], references: [id])

  @@map("customer_invoice_lines")
}

/// A payment against one invoice. Exactly one of the two invoice foreign keys is
/// set: the database cannot express that with two nullable columns, so the
/// route rejects any body that names both or neither.
model Payment {
  id                String       @id @default(cuid())
  party             PaymentParty
  supplierInvoiceId String?
  customerInvoiceId String?
  amount            Decimal      @db.Decimal(14, 2)
  method            String       @default("BANK_TRANSFER")
  reference         String?
  paidAt            DateTime     @default(now())
  createdAt         DateTime     @default(now())

  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  customerInvoice CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)

  @@index([party, paidAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// HR
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id           String         @id @default(cuid())
  employeeCode String         @unique
  firstName    String
  lastName     String
  email        String?        @unique
  phone        String?
  department   String
  position     String
  hireDate     DateTime       @default(now())
  /// Monthly gross salary. Nullable: not every employee record is payroll-grade.
  salary       Decimal?       @db.Decimal(14, 2)
  status       EmployeeStatus @default(ACTIVE)
  /// Links the person to a login. One employee to one account, so the reverse
  /// side on User is a single optional profile rather than a list.
  userId       String?        @unique
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance Attendance[]

  @@index([department])
  @@index([status])
  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

/// One row per employee per day, enforced by the unique index: a duplicated
/// check-in is a second row the shift report would double-count, so it is a
/// conflict rather than an overwrite.
model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@map("attendance")
}
