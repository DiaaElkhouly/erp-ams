# Database
DATABASE_URL="postgresql://ims_user:ims_password@localhost:5432/ims_db?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ims_user:ims_password@localhost:5432/ims_db?schema=public"

# Auth
AUTH_SECRET="replace-with-a-long-random-string-openssl-rand-base64-32"
# AUTH_URL is the canonical origin. Setting it is also what tells Auth.js to trust
# the incoming Host outside development - without it, `next dev` signs in fine but
# a production build (`npm run build && npm start`) bounces every login to
# /api/auth/error with UntrustedHost. Vercel supplies its own signal, so this is
# only needed for a self-hosted production server.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Transactional email (password reset).
# Without RESEND_API_KEY the reset link is never emailed; in development it is
# returned to the caller instead, and outside development it is only logged.
# EMAIL_FROM must be on a domain verified in Resend, otherwise sends are rejected.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# EMAIL_FROM="IMS <noreply@your-domain.com>"

# App
NODE_ENV="development"
